# Database
DATABASE_URL=postgresql://kestrel:kestrel_dev_pass@localhost:5432/kestrel_support?schema=public

# Server
PORT=4000
NODE_ENV=development
JWT_SECRET=replace_with_long_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# AI Provider ('mock' works offline without any credentials; optional 'gemini' adapter)
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gemini-3.8-flash
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Frontend (used by Vite)
VITE_API_BASE_URL=http://localhost:4000/api/v1
