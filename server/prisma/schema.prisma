generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  SUPPORT
  ADMIN
}

enum OrderStatus {
  PLACED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ProductCategory {
  ELECTRONICS
  APPAREL
  HOME_LIVING
  ACCESSORIES
  BOOKS_PRINT
  DIGITAL
  PERISHABLE
  PERSONALIZED
}

enum TicketCategory {
  ORDER_DELIVERY
  REFUND_RETURN
  PRODUCT_QUALITY
  PAYMENT_BILLING
  ACCOUNT
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  ESCALATED
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MessageSenderType {
  CUSTOMER
  AI
  STAFF
  SYSTEM
}

enum MessageVisibility {
  PUBLIC
  INTERNAL
}

enum RefundStatus {
  REQUESTED
  PROCESSING
  PENDING_REVIEW
  APPROVED
  REJECTED
  COMPLETED
  FAILED
  CANCELLED
}

enum EscalationDecision {
  PENDING
  APPROVED
  REJECTED
  MORE_INFO
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(CUSTOMER)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  orders              Order[]
  tickets             Ticket[]       @relation("CustomerTickets")
  assignedTickets     Ticket[]       @relation("AssignedTickets")
  sentMessages        Message[]
  requestedRefunds    Refund[]       @relation("RequestedRefunds")
  reviewedRefunds     Refund[]       @relation("ReviewedRefunds")
  assignedEscalations Escalation[]   @relation("AssignedEscalations")
  reviewedEscalations Escalation[]   @relation("ReviewedEscalations")
  internalNotes       InternalNote[]
  auditEvents         AuditEvent[]

  @@index([role])
}

model Order {
  id           String      @id @default(uuid()) @db.Uuid
  orderNumber  String      @unique
  customerId   String      @db.Uuid
  status       OrderStatus @default(PLACED)
  placedAt     DateTime    @db.Timestamptz(6)
  deliveryDate DateTime?   @db.Timestamptz(6)
  shippingFee  Decimal     @default(0) @db.Decimal(12, 2)
  totalAmount  Decimal     @db.Decimal(12, 2)
  currency     String      @default("INR")
  createdAt    DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @db.Timestamptz(6)

  customer User        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items    OrderItem[]
  tickets  Ticket[]
  refunds  Refund[]

  @@index([customerId, placedAt])
}

model OrderItem {
  id           String          @id @default(uuid()) @db.Uuid
  orderId      String          @db.Uuid
  productName  String
  category     ProductCategory
  isReturnable Boolean         @default(true)
  quantity     Int
  unitPrice    Decimal         @db.Decimal(12, 2)
  lineTotal    Decimal         @db.Decimal(12, 2)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Ticket {
  id           String         @id @default(uuid()) @db.Uuid
  ticketNumber String         @unique
  customerId   String         @db.Uuid
  orderId      String?        @db.Uuid
  subject      String
  description  String
  category     TicketCategory @default(OTHER)
  status       TicketStatus   @default(OPEN)
  priority     TicketPriority @default(MEDIUM)
  assignedToId String?        @db.Uuid
  createdAt    DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @db.Timestamptz(6)
  resolvedAt   DateTime?      @db.Timestamptz(6)

  customer      User           @relation("CustomerTickets", fields: [customerId], references: [id], onDelete: Restrict)
  order         Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  assignedTo    User?          @relation("AssignedTickets", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages      Message[]
  refunds       Refund[]
  escalations   Escalation[]
  internalNotes InternalNote[]
  auditEvents   AuditEvent[]

  @@index([status, priority, createdAt])
  @@index([customerId])
  @@index([assignedToId])
}

model Message {
  id           String            @id @default(uuid()) @db.Uuid
  ticketId     String            @db.Uuid
  senderType   MessageSenderType
  senderUserId String?           @db.Uuid
  content      String
  visibility   MessageVisibility @default(PUBLIC)
  metadata     Json?
  createdAt    DateTime          @default(now()) @db.Timestamptz(6)

  ticket     Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderUser User?  @relation(fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
}

model Refund {
  id              String       @id @default(uuid()) @db.Uuid
  refundNumber    String       @unique
  orderId         String       @db.Uuid
  ticketId        String       @db.Uuid
  requestedById   String       @db.Uuid
  reviewedById    String?      @db.Uuid
  amount          Decimal      @db.Decimal(12, 2)
  reason          String
  status          RefundStatus @default(REQUESTED)
  reviewComment   String?
  simulatedTxnRef String?
  idempotencyKey  String       @unique
  createdAt       DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(6)
  reviewedAt      DateTime?    @db.Timestamptz(6)
  completedAt     DateTime?    @db.Timestamptz(6)

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  ticket      Ticket       @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  requestedBy User         @relation("RequestedRefunds", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy  User?        @relation("ReviewedRefunds", fields: [reviewedById], references: [id], onDelete: SetNull)
  escalations Escalation[]
  auditEvents AuditEvent[]

  @@index([status, createdAt])
  @@index([orderId])
  @@index([ticketId])
}

model Escalation {
  id            String             @id @default(uuid()) @db.Uuid
  ticketId      String             @db.Uuid
  refundId      String?            @db.Uuid
  summary       String
  priority      TicketPriority     @default(HIGH)
  decision      EscalationDecision @default(PENDING)
  internalNote  String?
  requestedInfo String?
  assignedToId  String?            @db.Uuid
  reviewedById  String?            @db.Uuid
  createdAt     DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(6)
  resolvedAt    DateTime?          @db.Timestamptz(6)

  ticket     Ticket  @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  refund     Refund? @relation(fields: [refundId], references: [id], onDelete: SetNull)
  assignedTo User?   @relation("AssignedEscalations", fields: [assignedToId], references: [id], onDelete: SetNull)
  reviewedBy User?   @relation("ReviewedEscalations", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([decision, createdAt])
  @@index([ticketId])
}

model InternalNote {
  id        String   @id @default(uuid()) @db.Uuid
  ticketId  String   @db.Uuid
  authorId  String   @db.Uuid
  content   String
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
}

model AuditEvent {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @db.Uuid
  ticketId  String?  @db.Uuid
  refundId  String?  @db.Uuid
  eventType String
  details   Json
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  actor  User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  ticket Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  refund Refund? @relation(fields: [refundId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@index([refundId, createdAt])
  @@index([eventType, createdAt])
}

model PolicyDocument {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  title     String
  version   String
  content   String
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}

model RevokedToken {
  id        String   @id @default(uuid()) @db.Uuid
  jti       String   @unique
  expiresAt DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([expiresAt])
}
